# Application server
PORT=3001
CORS_ORIGIN=*
NODE_ENV=development
LOG_LEVEL=info

# PocketBase
POCKETBASE_URL=http://localhost:8090

# Coinbase API credentials
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_API_SECRET=your-coinbase-api-secret

# PocketBase superuser credentials
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# Telegram bot credentials
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Oracle Trader Pro encryption key
ORACLE_CREDENTIALS_ENCRYPTION_KEY=change-me

# Coinbase webhook secret
COINBASE_WEBHOOK_SECRET=change-me
